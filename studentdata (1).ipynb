# 17. CORRELATION ANALYSIS
# ================================================================

correlation_pairs = [

    ("self_learning_hours_daily", "skill_rating"),

    ("domain_practice_hours_weekly", "skill_rating"),

    ("projects_completed", "skill_rating"),

    ("entertainment_hours_daily", "self_learning_hours_daily"),

    ("skill_rating", "job_confidence"),

    ("projects_completed", "job_confidence")

]


correlation_results = []


for x_col, y_col in correlation_pairs:

    if x_col not in df.columns or y_col not in df.columns:
        continue

    pair_data = df[[x_col, y_col]].dropna()

    # Require at least three valid observations
    if len(pair_data) < 3:
        continue

    # Pearson and Spearman require variation in both variables
    if (
        pair_data[x_col].nunique() < 2
        or pair_data[y_col].nunique() < 2
    ):
        continue

    pearson_r, pearson_p = stats.pearsonr(
        pair_data[x_col],
        pair_data[y_col]
    )

    spearman_r, spearman_p = stats.spearmanr(
        pair_data[x_col],
        pair_data[y_col]
    )

    correlation_results.append({

        "Variable 1": x_col,

        "Variable 2": y_col,

        "Valid Observations": len(pair_data),

        "Pearson Correlation": pearson_r,

        "Pearson P-value": pearson_p,

        "Spearman Correlation": spearman_r,

        "Spearman P-value": spearman_p

    })


correlation_summary = pd.DataFrame(correlation_results)

print("\n========== CORRELATION RESULTS ==========")
print(correlation_summary.round(4))

print(
    "Inference: Correlation measures the strength and direction "
    "of association between variables. Correlation does not "
    "establish causation."
