# Convert long survey question headings into standard text
def clean_column_name(column):

    column = str(column).lower().strip()

    column = column.replace("â€“", "-")
    column = column.replace("â€™", "'")

    column = re.sub(r"[^a-z0-9]+", " ", column)
    column = re.sub(r"\s+", " ", column)

    return column.strip()


