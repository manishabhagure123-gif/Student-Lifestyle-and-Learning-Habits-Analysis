# ================================================================
# 20. 95% CONFIDENCE INTERVAL
# ================================================================

confidence_interval_columns = [

    "domain_practice_hours_weekly",

    "skill_rating"

]


confidence_interval_results = []


for col in confidence_interval_columns:

    if col not in df.columns:
        continue

    series = df[col].dropna()

    n = len(series)

    if n < 2:
        continue

    mean_value = series.mean()

    standard_error = stats.sem(series)

    t_critical = stats.t.ppf(
        0.975,
        df=n - 1
    )

    margin_error = t_critical * standard_error

    lower_limit = mean_value - margin_error

    upper_limit = mean_value + margin_error

    confidence_interval_results.append({

        "Variable": col,

        "Sample Size": n,

        "Sample Mean": mean_value,

        "Standard Error": standard_error,

        "95% Lower Limit": lower_limit,

        "95% Upper Limit": upper_limit

    })


confidence_interval_summary = pd.DataFrame(
    confidence_interval_results
)

print("\n========== 95% CONFIDENCE INTERVAL ==========")
print(confidence_interval_summary.round(3))

print(
    "Inference: The confidence interval estimates a range "
    "for the population mean under statistical assumptions. "
    "Convenience sampling may limit population generalisation."
)


# ================================================================
# 21. SAMPLE SIZE EXPERIMENT
# ================================================================

sample_variable = "domain_practice_hours_weekly"

sample_size_summary = pd.DataFrame()

if sample_variable in df.columns:

    population_data = df[sample_variable].dropna().to_numpy()

    sample_sizes = [30, 50, 100, 150]

    simulation_results = []

    number_of_simulations = 100

    for sample_size in sample_sizes:

        if len(population_data) < sample_size:

            print(
                "Skipping sample size",
                sample_size,
                "- insufficient valid observations."
            )

            continue

        sample_means = []

        for i in range(number_of_simulations):

            sample = np.random.choice(
                population_data,
                size=sample_size,
                replace=False
            )

            sample_means.append(sample.mean())

        simulation_results.append({

            "Sample Size": sample_size,

            "Average Sample Mean": np.mean(sample_means),

            "Standard Deviation of Sample Means": np.std(
                sample_means,
                ddof=1
            ),

            "Minimum Sample Mean": np.min(sample_means),

            "Maximum Sample Mean": np.max(sample_means)

        })


    sample_size_summary = pd.DataFrame(simulation_results)

    print("\n========== SAMPLE SIZE EXPERIMENT ==========")
    print(sample_size_summary.round(3))

    if not sample_size_summary.empty:

        plt.figure(figsize=(8, 5))

        sns.lineplot(
            data=sample_size_summary,
            x="Sample Size",
            y="Standard Deviation of Sample Means",
            marker="o"
        )

        plt.title("Effect of Sample Size on Sample Mean Variation")
        plt.xlabel("Sample Size")
        plt.ylabel("Standard Deviation of Sample Means")

        plt.tight_layout()
        plt.show()

    print(
        "Inference: Larger sample sizes generally reduce "
        "the variability of sample means. This experiment uses "
        "the available survey responses and does not establish "
        "that the survey sample represents all students."
    )

else:

    print("Weekly domain practice column is not available.")


# ================================================================
# 22. DOMAIN-WISE STATISTICAL ANALYSIS
# ================================================================

domain_analysis_columns = [

    "skill_rating",

    "domain_practice_hours_weekly",

    "projects_completed",

    "job_confidence"

]


domain_summary = pd.DataFrame()

if "career_domain" in df.columns:

    available_domain_columns = [

        col for col in domain_analysis_columns

        if col in df.columns

    ]

    if available_domain_columns:

        domain_data = df[
            ["career_domain"] + available_domain_columns
        ].copy()

        domain_data = domain_data.dropna(
            subset=["career_domain"]
        )

        # Build aggregation instructions dynamically.
        # Each measure includes its valid observation count
        # so missing data is visible.
        aggregation = {
            "Student_Count": ("career_domain", "size")
        }

        for col in available_domain_columns:

            aggregation[col + "_Mean"] = (col, "mean")

            aggregation[col + "_Valid_Count"] = (col, "count")

        domain_summary = (

            domain_data

            .groupby("career_domain")

            .agg(**aggregation)

            .reset_index()

        )

        print("\n========== DOMAIN-WISE SUMMARY ==========")
        print(domain_summary.round(2))


        # Plot average skill rating by career domain
        if "skill_rating" in available_domain_columns:

            plot_data = domain_data.dropna(
                subset=["skill_rating"]
            )

            if not plot_data.empty:

                plt.figure(figsize=(10, 5))

                sns.barplot(
                    data=plot_data,
                    x="career_domain",
                    y="skill_rating",
                    errorbar=None
                )

                plt.title("Average Skill Rating by Career Domain")
                plt.xlabel("Career Domain")
                plt.ylabel("Average Skill Rating")

                plt.xticks(rotation=45, ha="right")

                plt.tight_layout()
                plt.show()


        print(
            "Inference: Domain-wise analysis compares student counts, "
            "average skill ratings, practice hours, projects and "
            "self-reported job confidence."
        )

    else:

        print("No suitable domain analysis variables are available.")

else:

    print("Career domain column is not available.")


# ================================================================
# 23. PRACTICE FREQUENCY ANALYSIS
# ================================================================

if "practice_frequency" in df.columns:

    practice_frequency = df[
        "practice_frequency"
    ].value_counts(dropna=True)

    print("\n========== PRACTICE FREQUENCY ==========")
    print(practice_frequency)

    if not practice_frequency.empty:

        plt.figure(figsize=(8, 5))

        sns.barplot(
            x=practice_frequency.index.astype(str),
            y=practice_frequency.values
        )

        plt.title("Student Domain Practice Frequency")
        plt.xlabel("Practice Frequency")
        plt.ylabel("Number of Students")

        plt.xticks(rotation=45, ha="right")

        plt.tight_layout()
        plt.show()

    print(
        "Inference: This analysis identifies how frequently "
        "students practise their selected career-domain skills."
    )

else:

    print("Practice frequency column is not available.")


# ================================================================
# 24. SELF-REPORTED CONFIDENCE INDEX
# ================================================================

confidence_columns = [

    "apply_knowledge_confidence",

    "solve_independently_confidence",

    "explain_project_confidence",

    "job_confidence"

]


available_confidence_columns = [

    col for col in confidence_columns

    if col in df.columns

]


if available_confidence_columns:

    # Calculate mean of available confidence ratings.
    # Missing ratings are ignored, not filled with zero.
    df["confidence_index"] = df[
        available_confidence_columns
    ].mean(axis=1, skipna=True)

    print("\n========== CONFIDENCE INDEX ==========")

    print("Calculated using:", available_confidence_columns)

    print(df["confidence_index"].describe().round(2))

    plt.figure(figsize=(8, 5))

    sns.histplot(
        df["confidence_index"].dropna(),
        bins=10,
        kde=True
    )

    plt.title("Distribution of Self-Reported Confidence Index")
    plt.xlabel("Confidence Index")
    plt.ylabel("Number of Students")

    plt.tight_layout()
    plt.show()

    print(
        "Inference: The confidence index summarises student "
        "self-reported confidence across the available questions. "
        "It is not an objective employability score."
    )

else:

    print("Confidence index cannot be calculated.")


