# Reasonable limits for the survey variables
validation_rules = {

    "age": (15, 80),

    "sleep_hours_daily": (0, 24),

    "mobile_hours_daily": (0, 24),

    "entertainment_hours_daily": (0, 24),

    "self_learning_hours_daily": (0, 24),

    "domain_practice_hours_weekly": (0, 168),

    "physical_activity_hours_weekly": (0, 168),

    "project_hours_weekly": (0, 168),

    "skill_rating": (1, 5),

    "projects_completed": (0, None),

    "independent_projects": (0, None),

    "real_world_problem_hours_weekly": (0, 168),

    "certifications": (0, None),

    "internships": (0, None),

    "apply_knowledge_confidence": (1, 5),

    "solve_independently_confidence": (1, 5),

    "explain_project_confidence": (1, 5),

    "job_confidence": (1, 5)

}


validation_results = []


for col, limits in validation_rules.items():

    if col not in df.columns:
        continue

    lower_limit, upper_limit = limits

    invalid_mask = df[col].notna()

    if lower_limit is not None:

        invalid_mask &= df[col] < lower_limit

    if upper_limit is not None:

        invalid_mask |= (
            df[col].notna() &
            (df[col] > upper_limit)
        )

    invalid_count = invalid_mask.sum()

    validation_results.append({

        "Variable": col,

        "Invalid Values": invalid_count,

        "Lower Limit": lower_limit,

        "Upper Limit": upper_limit

    })

    # Flag invalid values and set them to missing.
    # They are not silently deleted.
    df.loc[invalid_mask, col] = np.nan


validation_report = pd.DataFrame(validation_results)

