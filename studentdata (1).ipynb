# }

manual_mapping = {}


# Find matching survey columns
def find_column(alias_list, available_columns):

    # First try exact matching
    for alias in alias_list:

        alias = clean_column_name(alias)

        if alias in available_columns:
            return alias

    # Next try unique phrase matching
    for alias in sorted(alias_list, key=len, reverse=True):

        alias = clean_column_name(alias)

        if len(alias) >= 8:

            matches = [
                col for col in available_columns
                if alias in col
            ]

            if len(matches) == 1:
                return matches[0]

    return None


# Create mapping
